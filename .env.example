# Configuração local. O `python -m prospecta instalar` cria o .env a partir deste arquivo.

# Seu e-mail para o OpenStreetMap (Nominatim), que pede um contato de quem usa o serviço público
# de mapas. Fica só no seu computador.
CONTATO_GEOCODER=

# Onde o motor de busca responde. Troque a porta se a 8080 estiver ocupada (ex.: 8081).
MOTOR_URL=http://localhost:8080
# Só se você definiu SCRAPER_API_KEY no kit:
MOTOR_CHAVE=

# Opcional: um servidor OSRM próprio para distâncias e tempos reais de carro nas rotas.
OSRM_URL=

# Limites que protegem seu IP de bloqueio do Google.
BUSCAS_POR_DIA=20
RAIO_MAXIMO_KM=15

# ── Opcional: usar pelo celular, com um bot de Telegram (veja o README) ──
# Token do @BotFather:
TELEGRAM_TOKEN=
# IDs do Telegram autorizados, separados por vírgula (mande /start ao bot para descobrir o seu):
USUARIOS_PERMITIDOS=
