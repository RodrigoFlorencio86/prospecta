# Copie para .env e preencha. Nunca publique o .env (ele tem o token do bot).

# Token do bot: fale com @BotFather no Telegram, /newbot, e cole aqui.
TELEGRAM_TOKEN=

# IDs do Telegram que podem usar o bot, separados por vírgula. Não sabe o seu? Deixe vazio,
# ligue o bot e mande /start: ele responde com o seu ID.
USUARIOS_PERMITIDOS=

# Onde está o motor de busca do google-maps-scraper-kit (no docker-compose já vem configurado).
MOTOR_URL=http://localhost:8080
# Só se você definiu SCRAPER_API_KEY no kit:
MOTOR_CHAVE=

# Seu e-mail para o Nominatim (OpenStreetMap), que pede um contato de quem usa o serviço público.
CONTATO_GEOCODER=

# Opcional: um servidor OSRM próprio para distâncias e tempos reais de carro nas rotas.
# Sem ele, as rotas usam distância estimada (linha reta x 1,35).
OSRM_URL=

# Limites para não ter o IP bloqueado pelo Google.
BUSCAS_POR_DIA=20
RAIO_MAXIMO_KM=15
